// Schema extension for CRM Pro Plugin
// Add these models to your main schema.prisma or import this file

model CrmAccount {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  industry        String?
  website         String?
  phone           String?
  billingAddress  Json?    // { street, city, zip, country }
  shippingAddress Json?
  annualRevenue   Float?
  employeeCount   Int?
  description     String?
  ownerId         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  contacts        CrmContact[]
  deals           CrmDeal[]
  activities      CrmActivity[]

  @@index([tenantId])
  @@index([ownerId])
}

model CrmContact {
  id              String   @id @default(cuid())
  tenantId        String
  accountId       String?
  account         CrmAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  firstName       String
  lastName        String
  email           String?
  phone           String?
  jobTitle        String?
  isDecisionMaker Boolean  @default(false)
  linkedInUrl     String?
  ownerId         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deals           CrmDeal[]
  activities      CrmActivity[]

  @@index([tenantId])
  @@index([accountId])
}

model CrmDeal {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  stage       String   // 'new', 'qualified', 'proposal', 'negotiation', 'closed_won', 'closed_lost'
  amount      Float?
  currency    String   @default("EUR")
  probability Int?     // 0-100
  closeDate   DateTime?
  status      String   @default("open") // open, won, lost
  description String?
  accountId   String?
  account     CrmAccount? @relation(fields: [accountId], references: [id])
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contacts    CrmContact[]
  products    CrmDealProduct[]
  activities  CrmActivity[]

  @@index([tenantId])
  @@index([stage])
  @@index([status])
}

model CrmProduct {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  sku         String?
  description String?
  unitPrice   Float
  currency    String   @default("EUR")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deals       CrmDealProduct[]

  @@index([tenantId])
}

model CrmDealProduct {
  id        String  @id @default(cuid())
  dealId    String
  productId String
  quantity  Int     @default(1)
  unitPrice Float   // Snapshot du prix au moment de la création
  total     Float
  
  deal      CrmDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  product   CrmProduct @relation(fields: [productId], references: [id])

  @@unique([dealId, productId])
}

model CrmActivity {
  id            String   @id @default(cuid())
  tenantId      String
  type          String   // 'call', 'meeting', 'email', 'task', 'note'
  subject       String
  description   String?
  status        String   // 'scheduled', 'completed', 'cancelled'
  dueDate       DateTime?
  completedAt   DateTime?
  relatedToId   String?  // ID polymorphique (Account, Deal, Contact)
  relatedToType String?  // 'account', 'deal', 'contact'
  
  accountId     String?
  account       CrmAccount? @relation(fields: [accountId], references: [id])
  
  contactId     String?
  contact       CrmContact? @relation(fields: [contactId], references: [id])
  
  dealId        String?
  deal          CrmDeal? @relation(fields: [dealId], references: [id])

  ownerId       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([relatedToId])
  @@index([dueDate])
}
