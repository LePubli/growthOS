{
  "slug": "crm-pro",
  "name": "CRM Pro Suite",
  "version": "1.0.0",
  "description": "Système CRM complet : Comptes, Contacts, Deals, Activités, Produits et Reporting.",
  "author": "GrowthOS Team",
  "isActive": true,
  "permissions": [
    "accounts:read", "accounts:write",
    "contacts:read", "contacts:write",
    "deals:read", "deals:write",
    "activities:read", "activities:write",
    "products:read", "products:write"
  ],
  "hooks": [
    "prospect:created",
    "pipeline:stageChanged",
    "sequence:enrolled"
  ],
  "routes": [
    "/api/v1/plugins/crm/accounts",
    "/api/v1/plugins/crm/contacts",
    "/api/v1/plugins/crm/deals",
    "/api/v1/plugins/crm/activities",
    "/api/v1/plugins/crm/products",
    "/api/v1/plugins/crm/reports"
  ],
  "uiSlots": [
    { "slot": "prospect-actions", "component": "CrmQuickActions" },
    { "slot": "dashboard-top", "component": "CrmDashboardWidgets" },
    { "slot": "pipeline-extension", "component": "CrmDealDetails" }
  ],
  "database": {
    "tables": [
      "CrmAccounts",
      "CrmContacts",
      "CrmDeals",
      "CrmActivities",
      "CrmProducts",
      "CrmDealProducts"
    ]
  }
}
