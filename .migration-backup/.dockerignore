# Version control
.git
.gitignore

# Dependencies (reinstalled inside Docker)
node_modules
**/node_modules
.pnpm-store

# Build outputs (rebuilt inside Docker)
**/dist
**/.turbo

# Development & editor files
.env.local
.env.*.local
*.log
.DS_Store
.replit
.local/
.agents/

# Migration backup (not needed in production image)
.migration-backup/

# Test and CI
**/*.test.*
**/*.spec.*
coverage/

# Exclude source of artifacts not needed for the frontend build,
# but keep their package.json so pnpm can resolve the full lockfile
artifacts/api-server/src/
artifacts/api-server/dist/
artifacts/api-server/node_modules/
artifacts/mockup-sandbox/src/
artifacts/mockup-sandbox/dist/
artifacts/mockup-sandbox/node_modules/

# Replit-specific
**/.replit
**/replit.nix
attached_assets/
