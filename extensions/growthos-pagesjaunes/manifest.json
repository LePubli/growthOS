{
  "manifest_version": 3,
  "name": "GrowthOS — Connecteur multisource",
  "version": "0.11.1",
  "description": "Outils spécialisés de collecte et enrichissement ciblé des prospects GrowthOS, avec confirmation des données visibles.",
  "permissions": [
    "tabs",
    "scripting",
    "activeTab",
    "storage"
  ],
  "action": {
    "default_title": "GrowthOS — Collecter des entreprises",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://www.pagesjaunes.fr/*",
    "https://pagesjaunes.fr/*",
    "https://recherche-entreprises.api.gouv.fr/*",
    "https://data.geopf.fr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://agile.le-publicitaire.fr/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
