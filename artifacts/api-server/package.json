{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:realistic": "tsx src/db/seed-realistic-data.ts",
    "test:e2e": "tsx src/tests/run-all-tests.ts",
    "test:e2e:report": "tsx src/scripts/test-report.ts",
    "test:e2e:coverage": "tsx src/tests/run-all-tests.ts --coverage",
    "test:e2e:legacy": "tsx src/scripts/verify-e2e.ts",
    "audit:tenant": "tsx src/scripts/audit-tenant-routes.ts",
    "migrate:tenant": "tsx src/scripts/migrate-tenant-data.ts",
    "migrate:tenant:dry": "tsx src/scripts/migrate-tenant-data.ts --dry-run",
    "coverage:api": "tsx src/scripts/api-coverage-dashboard.ts",
    "cleanup:fake-data": "tsx src/scripts/cleanup-fake-data.ts",
    "cleanup:fake-data:dry": "tsx src/scripts/cleanup-fake-data.ts -- --dry-run",
    "seed:demo": "tsx src/scripts/cleanup-fake-data.ts && tsx src/db/seed-realistic-data.ts",
    "test:report": "tsx src/scripts/test-coverage-report.ts"
  },
  "dependencies": {
    "@types/adm-zip": "^0.5.8",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "adm-zip": "^0.5.17",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
