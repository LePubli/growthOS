# =============================================================
# GrowthOS — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs réelles.
# Ne jamais committer .env dans Git.
# =============================================================

# -------------------------------------------------------------
# BASE DE DONNÉES PostgreSQL
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# -------------------------------------------------------------
DATABASE_URL=postgresql://growthos:changeme@localhost:5432/growthos

# Connexion individuelle (utilisé par certains outils CLI)
PGHOST=localhost
PGPORT=5432
PGDATABASE=growthos
PGUSER=growthos
PGPASSWORD=changeme

# -------------------------------------------------------------
# AUTHENTIFICATION JWT
# Générer des secrets forts : openssl rand -hex 64
# -------------------------------------------------------------
JWT_SECRET=changeme-generate-with-openssl-rand-hex-64
JWT_REFRESH_SECRET=changeme-generate-with-openssl-rand-hex-64

# -------------------------------------------------------------
# SERVEUR
# -------------------------------------------------------------
NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# -------------------------------------------------------------
# FRONTEND (Vite build args — configurés dans Coolify Build Variables)
# VITE_API_URL : URL publique de l'API (ex : https://api.mondomaine.com)
# BASE_PATH    : Préfixe d'URL si l'app n'est pas servie à la racine (défaut : /)
# -------------------------------------------------------------
VITE_API_URL=https://api.mondomaine.com
BASE_PATH=/

# -------------------------------------------------------------
# IA / LLM — Ollama (auto-hébergé)
# OLLAMA_BASE_URL : URL du serveur Ollama (local ou distant)
# OLLAMA_MODEL    : Modèle utilisé pour l'AI SDR, Deal Coach, etc.
# -------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# -------------------------------------------------------------
# STRIPE (paiements / abonnements)
# Clés disponibles sur https://dashboard.stripe.com/apikeys
# -------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# -------------------------------------------------------------
# EMAIL (SMTP — pour les séquences outreach)
# -------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@mondomaine.com
SMTP_PASSWORD=changeme
SMTP_FROM="GrowthOS <no-reply@mondomaine.com>"

# -------------------------------------------------------------
# WEBHOOKS SORTANTS
# Secret HMAC utilisé pour signer les payloads envoyés aux webhooks clients
# -------------------------------------------------------------
WEBHOOK_SIGNING_SECRET=changeme-generate-with-openssl-rand-hex-32

# -------------------------------------------------------------
# SESSION (cookie sécurisé)
# -------------------------------------------------------------
SESSION_SECRET=changeme-generate-with-openssl-rand-hex-32
