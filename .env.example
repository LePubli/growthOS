# ============================================================
# GrowthOS — Variables d'environnement
# Copier en .env et remplir les valeurs
# ============================================================

# ── Application ──────────────────────────────────────────────
NODE_ENV=production
APP_NAME=GrowthOS
APP_VERSION=1.0.0

# ── URLs ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://82.22.77.159:3001
NEXT_PUBLIC_APP_NAME=GrowthOS
CORS_ORIGINS=http://localhost:3000,http://82.22.77.159:3000

# ── Base de données ───────────────────────────────────────────
POSTGRES_USER=growthos
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://growthos:CHANGE_ME_STRONG_PASSWORD@postgres:5432/growthos

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_64_CHARS_RANDOM_SECRET_HERE
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── MinIO ─────────────────────────────────────────────────────
MINIO_ROOT_USER=growthos-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=growthos

# ── SMTP ─────────────────────────────────────────────────────
SMTP_HOST=mail.le-publicitaire.fr
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@le-publicitaire.fr
SMTP_FROM_NAME=GrowthOS

# ── IMAP ─────────────────────────────────────────────────────
IMAP_HOST=mail.le-publicitaire.fr
IMAP_PORT=993

# ── IA ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=

# ── Stripe (billing) ─────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ── APIs optionnelles ─────────────────────────────────────────
HUNTER_API_KEY=
DROPCONTACT_API_KEY=
APOLLO_API_KEY=
PAPPERS_API_KEY=
HUBSPOT_TOKEN=

# ── Monitoring ────────────────────────────────────────────────
SENTRY_DSN=

# ── Admin initial ────────────────────────────────────────────
ADMIN_EMAIL=admin@le-publicitaire.fr
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_COMPANY=Le Publicitaire

# ── OLLAMA  ────────────────────────────────────────────

# Ollama local (OBLIGATOIRE pour l'IA gratuite)
OLLAMA_HOST=http://ollama:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# Sur le serveur Ubuntu 24 :
# docker run -d --name ollama -p 11434:11434 -v ollama:/root/.ollama ollama/ollama
# docker exec ollama ollama pull llama3.2
