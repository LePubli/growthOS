# ============================================================
# GrowthOS - Variables d'Environnement
# ============================================================
# Copiez ce fichier en .env et remplissez les valeurs

# ── Base de Données ───────────────────────────────────────────────
DB_USER=growthos
DB_PASSWORD=change_me_in_production_please
DB_NAME=growthos_db
DB_PORT=5432

# URLs de connexion (pour l'app)
DATABASE_URL="postgresql://growthos:change_me_in_production_please@localhost:5432/growthos_db?schema=public"

# ── Redis ────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret_change_me
REDIS_PORT=6379
REDIS_URL="redis://:redis_secret_change_me@localhost:6379"

# ── Authentification & Sécurité ──────────────────────────────────
# Générez des secrets forts avec: openssl rand -hex 32
JWT_SECRET=change_me_in_production_please_min_32_chars
COOKIE_SECRET=another_secret_for_cookies_min_32_chars
SESSION_SECRET=session_secret_change_me

# Durée des tokens
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Application ──────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Plugin System ────────────────────────────────────────────────
PLUGIN_DIR=./apps/web/src/plugins
ENABLE_PLUGIN_SANDBOX=true
PLUGIN_STRICT_MODE=false # true en production

# ── Stockage Fichiers (MinIO/S3) ─────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_change_me
MINIO_BUCKET=growthos-files
MINIO_USE_SSL=false

# ── Services Externes (Optionnels) ───────────────────────────────
# IA / LLM
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM="GrowthOS <noreply@growthos.com>"

# Paiements
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Logging & Monitoring ─────────────────────────────────────────
LOG_LEVEL=info
ENABLE_SENTRY=false
SENTRY_DSN=

# ── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_TTL=60 # secondes
RATE_LIMIT_MAX=100 # requêtes par TTL

# ── File Upload ──────────────────────────────────────────────────
MAX_FILE_SIZE=10485760 # 10MB en bytes
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf,application/json

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_64_CHARS_RANDOM_SECRET_HERE
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── MinIO ─────────────────────────────────────────────────────
MINIO_ROOT_USER=growthos-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=growthos

# ── SMTP ─────────────────────────────────────────────────────
SMTP_HOST=mail.le-publicitaire.fr
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@le-publicitaire.fr
SMTP_FROM_NAME=GrowthOS

# ── IMAP ─────────────────────────────────────────────────────
IMAP_HOST=mail.le-publicitaire.fr
IMAP_PORT=993

# ── IA ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=

# ── Stripe (billing) ─────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ── APIs optionnelles ─────────────────────────────────────────
HUNTER_API_KEY=
DROPCONTACT_API_KEY=
APOLLO_API_KEY=
PAPPERS_API_KEY=
HUBSPOT_TOKEN=

# ── Monitoring ────────────────────────────────────────────────
SENTRY_DSN=

# ── Admin initial ────────────────────────────────────────────
ADMIN_EMAIL=admin@le-publicitaire.fr
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_COMPANY=Le Publicitaire

# ── OLLAMA  ────────────────────────────────────────────

# Ollama local (OBLIGATOIRE pour l'IA gratuite)
OLLAMA_HOST=http://ollama:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# Sur le serveur Ubuntu 24 :
# docker run -d --name ollama -p 11434:11434 -v ollama:/root/.ollama ollama/ollama
# docker exec ollama ollama pull llama3.2
