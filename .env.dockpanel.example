# Copy to .env (never commit the populated file).
# Generate each secret with the commands in DOCKPANEL_SETUP.md.
POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME
SETUP_TOKEN=CHANGE_ME

# Exact email of the platform owner after the setup wizard creates it.
PLATFORM_ADMIN_EMAILS=

GROWTHOS_HOST_PORT=13000
# preprod follows the last successful GitHub build of the release branch.
# For rollback, replace preprod with the immutable 40-character commit SHA.
GROWTHOS_IMAGE_PREFIX=ghcr.io/lepubli
GROWTHOS_IMAGE_TAG=preprod
RESEND_API_KEY=
EMAIL_FROM=
CORS_ORIGINS=
